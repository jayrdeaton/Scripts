{
  "name": "@jayrdeaton/scripts",
  "version": "2.1.2",
  "private": false,
  "description": "Personal dev scripts",
  "repository": {
    "type": "git",
    "url": "https://github.com/jayrdeaton/Scripts"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "jrd": "./bin/cli.mjs"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "fix": "npm run lint:fix",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "release": "git push --follow-tags",
    "release:major": "npm version major && npm run release",
    "release:minor": "npm version minor && npm run release",
    "release:patch": "npm version patch && npm run release",
    "verify": "npm run lint",
    "preversion": "npm ci && npm run verify"
  },
  "prettier": "@infinitetoken/eslint-config/prettier",
  "dependencies": {
    "termkit": "^2.4.8"
  },
  "devDependencies": {
    "@infinitetoken/eslint-config": "^0.1.4",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
